{
  "expo": {
    "name": "conectaai",
    "slug": "conectaai",
    "owner": "medeirosge",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android", "web"],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.medeirosge.conectaai",
      "versionCode": 5
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medeirosge.conectaai",
      "buildNumber": "4",
      "infoPlist": {
        "LSMinimumSystemVersion": "12.0",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/imagens/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "assetBundlePatterns": ["**/*"],
    "extra": {
      "eas": {
        "projectId": "1d5ad9e9-bf1c-41f2-8d75-66fc24dd2eaa"
      }
    }
  }
}
