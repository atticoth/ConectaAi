{
  "expo": {
    "name": "conectaai",
    "slug": "conectaai",
    "owner": "medeirosge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/imagens/icone.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "splash": {
      "image": "./assets/imagens/icone.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/imagens/icone.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.medeirosge.conectai",
      "versionCode": 4
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medeirosge.conectai",
      "buildNumber": "3",
      "infoPlist": {
        "LSMinimumSystemVersion": "12.0"
      }
    },
    "web": {
      "favicon": "./assets/imagens/icone.png"
    },
    "plugins": [
      "expo-build-properties"
    ],
    "extra": {
      "eas": {
        "projectId": "1d5ad9e9-bf1c-41f2-8d75-66fc24dd2eaa"
      }
    }
  }
}
